    "npm-run-all2": "^8.0.4",
    "prettier": "3.5.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
